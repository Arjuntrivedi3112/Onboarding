# Copy to .env (or .env.local) for local development.
# Only public values belong here: the anon key is designed to ship to browsers,
# and row-level security in supabase/migrations protects the data.

VITE_SUPABASE_PROJECT_ID=vnndkcsuzjrwoosatfke
VITE_SUPABASE_URL=https://vnndkcsuzjrwoosatfke.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
VITE_SUPABASE_PUBLISHABLE_KEY=your-anon-key

# Server-side secrets are NOT set here. They live in Supabase as function
# secrets (supabase secrets set ...): GROQ_API_KEY, GOOGLE_API_KEY.
